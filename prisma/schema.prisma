datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. Roles & Multi-Store Platform
// ----------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  STORE_ADMIN
  DOCTOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  PENDING_VERIFICATION
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  QUARANTINED
  RECALLED
}

enum MovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  DAMAGE
  EXPIRED_DISPOSAL
  ADJUSTMENT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  SPLIT
  CREDIT
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum InvoiceStatus {
  COMPLETED
  HELD
  CANCELLED
  REFUNDED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  BANK_DROP
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  username     String        @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role          @default(STORE_ADMIN)
  status       AccountStatus @default(ACTIVE)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  storeAssignments UserStoreAssignment[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  auditLogs        AuditLog[]
  loginEvents      LoginEvent[]
  stockMovements   StockMovement[]
  roleAssignments  UserRoleAssignment[]
  openedShifts     CashRegisterShift[]   @relation("ShiftOpenedBy")
  closedShifts     CashRegisterShift[]   @relation("ShiftClosedBy")
}

model Store {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique
  address         String?
  city            String?
  state           String?
  pincode         String?
  phone           String?
  email           String?
  gstin           String?
  drugLicenseNo   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  settings         StoreSetting?
  invoiceSequences InvoiceSequence[]
  userAssignments  UserStoreAssignment[]
  products         Product[]
  batches          ProductBatch[]
  suppliers        Supplier[]
  purchases        PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  salesInvoices    SalesInvoice[]
  salesReturns     SalesReturn[]
  customers        Customer[]
  stockMovements   StockMovement[]
  auditLogs        AuditLog[]
  gstFilings       GstFilingRecord[]
  accounts         Account[]
  journals         Journal[]
  journalEntries   JournalEntry[]
  roleAssignments  UserRoleAssignment[]
  shifts           CashRegisterShift[]
  cashMovements    CashMovement[]
}

model RoleDefinition {
  id          String   @id @default(uuid())
  code        String   @unique // SUPER_ADMIN, ADMIN, STORE_ADMIN, DOCTOR
  name        String   // Super Admin, Multi-Store Admin, Store Admin, Doctor
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermissionMapping[]
  userRoles   UserRoleAssignment[]
}

model Permission {
  id          String   @id @default(uuid())
  resource    String   // platform, users, pos, inventory, purchases, accounting, gst, doctor, digilocker
  action      String   // view, create, edit, delete, export, approve
  code        String   @unique // e.g. "users:create", "pos:checkout", "accounting:post"
  category    String
  description String?

  roles RolePermissionMapping[]
}

model RolePermissionMapping {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  storeId   String?  // null = platform-wide (Super Admin), or store-specific role
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  store Store?         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, storeId])
}

model UserStoreAssignment {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String?
  username  String
  ipAddress String?
  userAgent String?
  isSuccess Boolean
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  storeId   String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, entity])
  @@index([createdAt])
}

// ----------------------------------------------------
// 2. Product Master & Units of Measurement
// ----------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
}

model Unit {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "Tablet", "Strip", "Box", "Bottle", "Vial", "mL"
  code        String   @unique // e.g. "TAB", "STRIP", "BOX", "BTL", "ML"
  isBaseUnit  Boolean  @default(false)

  baseConversions   ProductUnitConversion[] @relation("FromUnit")
  targetConversions ProductUnitConversion[] @relation("ToUnit")
  baseProducts      Product[]               @relation("BaseUnit")
  purchaseProducts  Product[]               @relation("PurchaseUnit")
  saleProducts      Product[]               @relation("SaleUnit")
  salesItems        SalesItem[]
  purchaseItems     PurchaseItem[]
  stockMovements    StockMovement[]
}

model Product {
  id                     String   @id @default(uuid())
  storeId                String?  // null for global master, or store-specific
  name                   String
  brandName              String?
  genericName            String?  // Composition / Salt
  manufacturer           String?
  categoryId             String?
  dosageForm             String?  // Tablet, Capsule, Syrup, Injection, Ointment, etc.
  strength               String?  // 500mg, 10mg/5ml
  packDescription        String?  // 10 Tablets / Strip
  sku                    String   @unique
  barcode                String?  @unique
  qrCode                 String?
  hsnCode                String?
  gstRate                Decimal  @default(12.0) @db.Decimal(5, 2)
  mrp                    Decimal  @db.Decimal(12, 2)
  defaultPurchasePrice   Decimal  @db.Decimal(12, 2)
  defaultSellingPrice    Decimal  @db.Decimal(12, 2)
  baseUnitId             String
  purchaseUnitId         String
  saleUnitId             String
  reorderLevel           Int      @default(10)
  isPrescriptionRequired Boolean  @default(false)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  store        Store?                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  baseUnit     Unit                    @relation("BaseUnit", fields: [baseUnitId], references: [id])
  purchaseUnit Unit                    @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id])
  saleUnit     Unit                    @relation("SaleUnit", fields: [saleUnitId], references: [id])
  conversions  ProductUnitConversion[]
  batches      ProductBatch[]
  purchaseItems PurchaseItem[]
  salesItems    SalesItem[]
  stockMovements StockMovement[]

  @@index([storeId, name])
  @@index([barcode])
  @@index([genericName])
}

model ProductUnitConversion {
  id               String  @id @default(uuid())
  productId        String
  fromUnitId       String
  toUnitId         String
  conversionFactor Decimal @db.Decimal(10, 4) // e.g. 1 Strip = 10 Tablets (factor: 10)

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUnit Unit    @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit   Unit    @relation("ToUnit", fields: [toUnitId], references: [id])

  @@unique([productId, fromUnitId, toUnitId])
}

// ----------------------------------------------------
// 3. Batches & Inventory Management
// ----------------------------------------------------

model ProductBatch {
  id                String      @id @default(uuid())
  storeId           String
  productId         String
  batchNumber       String
  mfgDate           DateTime?
  expiryDate        DateTime
  purchasePrice     Decimal     @db.Decimal(12, 2)
  mrp               Decimal     @db.Decimal(12, 2)
  receivedQty       Decimal     @db.Decimal(12, 2) // Base units received
  availableQty      Decimal     @db.Decimal(12, 2) // Current available base units
  supplierId        String?
  purchaseInvoiceId String?
  status            BatchStatus @default(ACTIVE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  salesItems     SalesItem[]
  purchaseItems  PurchaseItem[]
  salesReturnItems SalesReturnItem[]

  @@unique([storeId, productId, batchNumber])
  @@index([expiryDate])
  @@index([status])
  @@index([productId, status, expiryDate])
  @@index([storeId, productId])
}

model StockMovement {
  id             String       @id @default(uuid())
  storeId        String
  productId      String
  batchId        String?
  movementType   MovementType
  quantity       Decimal      @db.Decimal(12, 2)
  unitId         String
  baseQuantity   Decimal      @db.Decimal(12, 2) // standardized into base unit
  referenceType  String?      // SALES_INVOICE, PURCHASE_INVOICE, RETURN, ADJUSTMENT
  referenceId    String?
  userId         String?
  reason         String?
  createdAt      DateTime     @default(now())

  store   Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch   ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  unit    Unit          @relation(fields: [unitId], references: [id])
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId, productId, createdAt])
}

// ----------------------------------------------------
// 4. Suppliers & Purchase Management
// ----------------------------------------------------

model Supplier {
  id             String   @id @default(uuid())
  storeId        String
  businessName   String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  gstin          String?
  drugLicenseNo  String?
  paymentTerms   String?  // e.g. "Net 30"
  openingBalance Decimal  @default(0.0) @db.Decimal(12, 2)
  currentBalance Decimal  @default(0.0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batches          ProductBatch[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  supplierPayments SupplierPayment[]

  @@index([storeId, businessName])
}

model PurchaseInvoice {
  id                    String        @id @default(uuid())
  storeId               String
  supplierId            String
  invoiceNumber         String        // internal purchase voucher number
  supplierInvoiceNumber String        // original bill number from supplier
  invoiceDate           DateTime
  receivedDate          DateTime      @default(now())
  subtotal              Decimal       @db.Decimal(12, 2)
  discountTotal         Decimal       @default(0.0) @db.Decimal(12, 2)
  taxTotal              Decimal       @default(0.0) @db.Decimal(12, 2)
  totalAmount           Decimal       @db.Decimal(12, 2)
  paidAmount            Decimal       @default(0.0) @db.Decimal(12, 2)
  paymentStatus         PaymentStatus @default(UNPAID)
  status                String        @default("POSTED") // DRAFT, POSTED, CANCELLED
  createdById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier    Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       PurchaseItem[]
  batches     ProductBatch[]
  returns     PurchaseReturn[]
  payments    SupplierPayment[]
  journalEntries JournalEntry[]

  @@unique([storeId, invoiceNumber])
  @@index([supplierInvoiceNumber])
  @@index([storeId, invoiceDate])
  @@index([storeId, paymentStatus])
}

model PurchaseItem {
  id                String   @id @default(uuid())
  purchaseInvoiceId String
  productId         String
  batchId           String?
  batchNumber       String
  mfgDate           DateTime?
  expiryDate        DateTime
  purchaseQty       Decimal  @db.Decimal(12, 2)
  unitId            String
  conversionFactor  Decimal  @default(1.0) @db.Decimal(10, 4)
  baseQuantity      Decimal  @db.Decimal(12, 2)
  unitRate          Decimal  @db.Decimal(12, 2)
  discountAmount    Decimal  @default(0.0) @db.Decimal(12, 2)
  gstRate           Decimal  @default(0.0) @db.Decimal(5, 2)
  gstAmount         Decimal  @default(0.0) @db.Decimal(12, 2)
  totalAmount       Decimal  @db.Decimal(12, 2)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch           ProductBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  unit            Unit            @relation(fields: [unitId], references: [id])
}

model SupplierPayment {
  id                String        @id @default(uuid())
  storeId           String
  supplierId        String
  purchaseInvoiceId String?
  paymentDate       DateTime      @default(now())
  amount            Decimal       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod @default(UPI)
  referenceNumber   String?
  notes             String?
  createdAt         DateTime      @default(now())

  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
}

model PurchaseReturn {
  id                String   @id @default(uuid())
  storeId           String
  supplierId        String
  purchaseInvoiceId String?
  returnNumber      String
  returnDate        DateTime @default(now())
  totalAmount       Decimal  @db.Decimal(12, 2)
  reason            String?
  createdAt         DateTime @default(now())

  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  items           PurchaseReturnItem[]

  @@unique([storeId, returnNumber])
}

model PurchaseReturnItem {
  id               String  @id @default(uuid())
  purchaseReturnId String
  productId        String
  batchId          String
  returnQty        Decimal @db.Decimal(12, 2)
  unitRate         Decimal @db.Decimal(12, 2)
  totalAmount      Decimal @db.Decimal(12, 2)
  reason           String?

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 5. Customers & Prescriptions
// ----------------------------------------------------

model Customer {
  id                 String   @id @default(uuid())
  storeId            String
  name               String
  phone              String?
  email              String?
  address            String?
  gstin              String?  // Registered business / clinic GSTIN
  abhaId             String?  // Ayushman Bharat Health Account (DigiLocker)
  digilockerVerified Boolean  @default(false)
  openingBalance     Decimal  @default(0.0) @db.Decimal(12, 2)
  currentBalance     Decimal  @default(0.0) @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime @default(now())

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
  salesInvoices SalesInvoice[]

  @@index([storeId, phone])
}

model Prescription {
  id               String    @id @default(uuid())
  storeId          String
  customerId       String?
  doctorName       String
  doctorRegNo      String?
  clinicName       String?
  prescriptionDate DateTime?
  imageUrl         String?
  digilockerUri    String?   // DigiLocker verifiable doc URI
  notes            String?
  createdAt        DateTime  @default(now())

  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesInvoices SalesInvoice[]
}

// ----------------------------------------------------
// 6. POS Billing, Sales & Returns
// ----------------------------------------------------

model SalesInvoice {
  id               String        @id @default(uuid())
  storeId          String
  invoiceNumber    String        // Sequential non-duplicated invoice number
  customerId       String?
  customerGstin    String?       // Recipient GSTIN if B2B sale
  invoiceType      String        @default("B2C") // "B2C" (Retail) or "B2B" (Business/Clinic)
  placeOfSupply    String?       @default("24 - Gujarat")
  isReverseCharge  Boolean       @default(false)
  prescriptionId   String?
  invoiceDate      DateTime      @default(now())
  subtotal         Decimal       @db.Decimal(12, 2)
  discountTotal    Decimal       @default(0.0) @db.Decimal(12, 2)
  taxTotal         Decimal       @default(0.0) @db.Decimal(12, 2)
  cgstTotal        Decimal       @default(0.0) @db.Decimal(12, 2)
  sgstTotal        Decimal       @default(0.0) @db.Decimal(12, 2)
  igstTotal        Decimal       @default(0.0) @db.Decimal(12, 2)
  grandTotal       Decimal       @db.Decimal(12, 2)
  paidAmount       Decimal       @db.Decimal(12, 2)
  changeAmount     Decimal       @default(0.0) @db.Decimal(12, 2)
  paymentStatus    PaymentStatus @default(PAID)
  paymentMethod    PaymentMethod @default(CASH)
  status           InvoiceStatus @default(COMPLETED)
  createdById      String?
  shiftId          String?
  digilockerDocUri String?       // DigiLocker digital invoice URI
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  prescription Prescription?      @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  shift        CashRegisterShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items        SalesItem[]
  payments     SalesPayment[]
  returns      SalesReturn[]
  journalEntries JournalEntry[]

  @@unique([storeId, invoiceNumber])
  @@index([createdAt])
  @@index([createdById])
  @@index([storeId, invoiceDate])
  @@index([storeId, paymentStatus])
  @@index([storeId, shiftId])
  @@index([invoiceNumber])
}

model SalesItem {
  id               String       @id @default(uuid())
  salesInvoiceId   String
  productId        String
  batchId          String
  saleUnitId       String
  quantity         Decimal      @db.Decimal(12, 2) // Quantity in saleUnit
  conversionFactor Decimal      @default(1.0) @db.Decimal(10, 4)
  baseQuantity     Decimal      @db.Decimal(12, 2) // Total deducted from batch in base unit
  unitPrice        Decimal      @db.Decimal(12, 2) // MRP or price per saleUnit
  discountType     DiscountType @default(PERCENTAGE)
  discountValue    Decimal      @default(0.0) @db.Decimal(10, 2)
  discountAmount   Decimal      @default(0.0) @db.Decimal(12, 2)
  netRate          Decimal      @db.Decimal(12, 2) // price after discount
  gstRate          Decimal      @default(0.0) @db.Decimal(5, 2)
  gstAmount        Decimal      @default(0.0) @db.Decimal(12, 2)
  subtotal         Decimal      @db.Decimal(12, 2)
  totalAmount      Decimal      @db.Decimal(12, 2)

  salesInvoice     SalesInvoice     @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch            ProductBatch     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  saleUnit         Unit             @relation(fields: [saleUnitId], references: [id])
  salesReturnItems SalesReturnItem[]

  @@index([salesInvoiceId])
  @@index([productId])
  @@index([batchId])
}

model SalesPayment {
  id             String        @id @default(uuid())
  salesInvoiceId String
  paymentMethod  PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime      @default(now())
  transactionRef String?
  notes          String?
  createdAt      DateTime      @default(now())

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
}

model SalesReturn {
  id                String   @id @default(uuid())
  storeId           String
  returnNumber      String
  originalInvoiceId String
  returnDate        DateTime @default(now())
  totalRefundAmount Decimal  @db.Decimal(12, 2)
  refundMethod      PaymentMethod @default(CASH)
  reason            String?
  createdById       String?
  createdAt         DateTime @default(now())

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  originalInvoice SalesInvoice      @relation(fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  items           SalesReturnItem[]

  @@unique([storeId, returnNumber])
}

model SalesReturnItem {
  id            String  @id @default(uuid())
  salesReturnId String
  salesItemId   String
  batchId       String
  returnQty     Decimal @db.Decimal(12, 2)
  baseQuantity  Decimal @db.Decimal(12, 2)
  refundAmount  Decimal @db.Decimal(12, 2)
  isRestocked   Boolean @default(true)
  reason        String?

  salesReturn SalesReturn  @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  salesItem   SalesItem    @relation(fields: [salesItemId], references: [id], onDelete: Restrict)
  batch       ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
}

// ----------------------------------------------------
// 7. Store Settings & Invoice Sequences
// ----------------------------------------------------

model StoreSetting {
  id                 String   @id @default(uuid())
  storeId            String   @unique
  invoicePrefix      String   @default("INV")
  thermalPrintWidth  Int      @default(80) // 80mm or 58mm
  expiryAlertDays    Int      @default(90) // alert batches expiring within 90 days
  lowStockThreshold  Int      @default(10)
  maxDiscountPercent Decimal  @default(20.0) @db.Decimal(5, 2)
  defaultTaxRate     Decimal  @default(5.0) @db.Decimal(5, 2)
  enableLooseSale    Boolean  @default(true)
  requireDoctorInfo  Boolean  @default(false)

  // GST Compliance Configuration
  gstScheme           String   @default("REGULAR") // "REGULAR" | "COMPOSITION"
  filingFrequency     String   @default("MONTHLY") // "MONTHLY" | "QRMP_QUARTERLY"
  stateCode           String   @default("24 - Gujarat")
  compositionTaxRate  Decimal  @default(1.0) @db.Decimal(5, 2)
  isEInvoicingEligible Boolean @default(false) // >5 Crore turnover IRN generation

  // DigiLocker Compliance & Healthcare Integration
  digilockerEnabled     Boolean @default(true)
  digilockerClientId    String?
  digilockerClientSecret String?
  digilockerIssuerId    String?
  digilockerOrgName     String  @default("City Medical Store")
  digilockerMode        String  @default("SANDBOX") // "SANDBOX" | "PRODUCTION"

  updatedAt          DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model InvoiceSequence {
  id           String @id @default(uuid())
  storeId      String
  series       String @default("SALES")
  year         Int
  lastSequence Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, series, year])
}

model GstFilingRecord {
  id              String   @id @default(uuid())
  storeId         String
  returnType      String   // GSTR1, GSTR3B, CMP08, PMT06, GSTR9, GSTR4
  taxPeriod       String   // e.g. "10-2026", "Q3-2026", "2026-2027"
  financialYear   String   @default("2026-2027")
  dueDate         DateTime?
  filingDate      DateTime?
  arnNumber       String?  // Application Reference Number
  status          String   @default("PENDING") // PENDING, READY, FILED
  taxableSales    Decimal  @default(0.0) @db.Decimal(12, 2)
  outputTax       Decimal  @default(0.0) @db.Decimal(12, 2)
  inputItc        Decimal  @default(0.0) @db.Decimal(12, 2)
  netTaxPaid      Decimal  @default(0.0) @db.Decimal(12, 2)
  digilockerDocId String?  // DigiLocker stored acknowledgment URI
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, returnType, taxPeriod])
}

// ----------------------------------------------------
// 8. Double-Entry Accounting Setup
// ----------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalType {
  CASH
  BANK
  SALE
  PURCHASE
  GENERAL
}

model Account {
  id             String        @id @default(uuid())
  storeId        String
  code           String        // e.g. "101000", "102000", "105000", "201000", "401000"
  name           String        // e.g. "Cash on Hand", "Bank & UPI", "Accounts Receivable"
  type           AccountType
  description    String?
  currentBalance Decimal       @default(0.0) @db.Decimal(12, 2)
  isSystem       Boolean       @default(true)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  journalItems    JournalItem[]
  defaultJournals Journal[]     @relation("JournalDefaultAccount")

  @@unique([storeId, code])
  @@index([storeId, type])
}

model Journal {
  id               String       @id @default(uuid())
  storeId          String
  code             String       // e.g. "CSH", "BNK", "INV", "BILL", "GEN"
  name             String       // e.g. "Cash Journal", "Bank Journal", "Customer Invoices"
  type             JournalType
  defaultAccountId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  defaultAccount Account?      @relation("JournalDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)
  entries        JournalEntry[]

  @@unique([storeId, code])
}

model JournalEntry {
  id                String           @id @default(uuid())
  storeId           String
  journalId         String
  entryNumber       String           // e.g. "JE-2026-00001"
  date              DateTime         @default(now())
  reference         String?          // Reference invoice / bill / payment #
  narration         String?          // Memo / explanation
  status            String           @default("POSTED") // "DRAFT", "POSTED", "CANCELLED"
  amount            Decimal          @default(0.0) @db.Decimal(12, 2)
  salesInvoiceId    String?
  purchaseInvoiceId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  journal         Journal          @relation(fields: [journalId], references: [id], onDelete: Restrict)
  salesInvoice    SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  items           JournalItem[]

  @@unique([storeId, entryNumber])
  @@index([storeId, date])
}

model JournalItem {
  id             String       @id @default(uuid())
  entryId        String
  accountId      String
  partnerType    String?      // "CUSTOMER" | "SUPPLIER" | "NONE"
  partnerId      String?      // customerId or supplierId
  partnerName    String?
  debit          Decimal      @default(0.0) @db.Decimal(12, 2)
  credit         Decimal      @default(0.0) @db.Decimal(12, 2)
  label          String?      // Line item description / memo
  name           String?      // Alternate label
  reconciled     Boolean      @default(false)
  matchingNumber String?      // e.g. "REC-001"
  createdAt      DateTime     @default(now())

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([partnerId])
  @@index([matchingNumber])
}

// ----------------------------------------------------
// 9. Cash Register & Daily Shifts Management
// ----------------------------------------------------

model CashRegisterShift {
  id                    String            @id @default(uuid())
  storeId               String
  shiftNumber           Int               @default(1)
  openedById            String
  closedById            String?
  status                ShiftStatus       @default(OPEN)

  openedAt              DateTime          @default(now())
  closedAt              DateTime?

  openingCashFloat      Decimal           @default(0.0) @db.Decimal(12, 2)
  openingBankBalance    Decimal           @default(0.0) @db.Decimal(12, 2)
  openingNotes          String?

  totalCashSales        Decimal           @default(0.0) @db.Decimal(12, 2)
  totalUpiSales         Decimal           @default(0.0) @db.Decimal(12, 2)
  totalCardSales        Decimal           @default(0.0) @db.Decimal(12, 2)
  totalCreditSales      Decimal           @default(0.0) @db.Decimal(12, 2)

  totalCustomerDuesCash Decimal           @default(0.0) @db.Decimal(12, 2)
  totalCustomerDuesBank Decimal           @default(0.0) @db.Decimal(12, 2)

  totalSupplierPaidCash Decimal           @default(0.0) @db.Decimal(12, 2)
  totalSupplierPaidBank Decimal           @default(0.0) @db.Decimal(12, 2)

  totalCashIn           Decimal           @default(0.0) @db.Decimal(12, 2)
  totalCashOut          Decimal           @default(0.0) @db.Decimal(12, 2)
  totalCashRefunds      Decimal           @default(0.0) @db.Decimal(12, 2)

  expectedClosingCash   Decimal           @default(0.0) @db.Decimal(12, 2)
  actualClosingCash     Decimal           @default(0.0) @db.Decimal(12, 2)
  cashVariance          Decimal           @default(0.0) @db.Decimal(12, 2)

  expectedClosingBank   Decimal           @default(0.0) @db.Decimal(12, 2)

  denominations         Json?
  closingNotes          String?

  store                 Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  openedBy              User              @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy              User?             @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  movements             CashMovement[]
  salesInvoices         SalesInvoice[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([storeId, status])
  @@index([storeId, openedAt])
}

model CashMovement {
  id          String            @id @default(uuid())
  shiftId     String
  storeId     String
  type        CashMovementType
  amount      Decimal           @db.Decimal(12, 2)
  reason      String
  createdById String
  createdAt   DateTime          @default(now())

  shift       CashRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, shiftId])
}


